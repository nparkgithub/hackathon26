<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MPQUIC Client"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deviceIps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:paddingTop="4dp" />

            <EditText
                android:id="@+id/serverAddr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Server address (ip:port)"
                android:inputType="text"
                android:text="10.0.2.2:4433" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/autoAddrSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Auto-fill local IPs from wlan + rmnet_data (IPv4 + IPv6)" />

            <EditText
                android:id="@+id/localAddrs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Local IPs for paths, comma-separated (blank = any)"
                android:inputType="text" />

            <TextView
                android:id="@+id/ifaceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:paddingBottom="4dp"
                android:text="Path interfaces: scanning..." />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/multipathSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Enable multipath" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="Scheduler" />

                <Spinner
                    android:id="@+id/mpAlgo"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="Congestion" />

                <Spinner
                    android:id="@+id/ccAlgo"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="Log level" />

                <Spinner
                    android:id="@+id/logLevel"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/connectBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Connect" />

                <Button
                    android:id="@+id/disconnectBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Disconnect" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/message"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content"
                    android:hint="Payload to send (raw bytes)"
                    android:inputType="text" />

                <Button
                    android:id="@+id/sendBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Send" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/bulkSize"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" />

                <Button
                    android:id="@+id/sendBulkBtn"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Send test payload" />
            </LinearLayout>

            <TextView
                android:id="@+id/stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:paddingTop="8dp"
                android:text="Not connected" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/logLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log"
        android:textStyle="bold"
        android:textSize="11sp"
        android:paddingTop="6dp" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#11000000">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:padding="4dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Per-path packets sent (last 60s)"
        android:textStyle="bold"
        android:textSize="11sp"
        android:paddingTop="6dp" />

    <com.mpquic.core.PathGraphView
        android:id="@+id/pathGraph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:background="#11000000" />
</LinearLayout>
