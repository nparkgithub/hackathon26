<?xml version="1.0" encoding="UTF-8"?>
<!--
  Default TQUIC transport configuration for the Multiverse Master Agent (grillme_version2 Sec 4.3).
  This file is the SOURCE OF TRUTH for default values. The config GUI loads these defaults and edits
  on top; TquicConfigLoader parses <param key default/> here and maps onto TquicConfig.
  Values use library (not CLI) semantics; units are noted per field.
-->
<tquicConfig version="1">
  <category name="connection">
    <param key="max_idle_timeout"          type="u64"  unit="ms"    default="30000"/>
    <param key="max_handshake_timeout"     type="u64"  unit="ms"    default="30000"/>
    <param key="active_connection_id_limit" type="u64"              default="2"     min="2"/>
    <param key="cid_len"                    type="u8"               default="8"     max="20"/>
    <param key="max_concurrent_conns"       type="u32"              default="1000000"/>
    <param key="anti_amplification_factor"  type="u8"               default="3"     min="3"/>
    <param key="send_batch_size"            type="u16"              default="64"/>
    <param key="max_undecryptable_packets"  type="u16"              default="10"/>
    <param key="zerortt_buffer_size"        type="u16"  unit="packets" default="1000"/>
    <param key="enable_retry"               type="bool"             default="false"/>
  </category>

  <category name="mtu">
    <param key="recv_udp_payload_size"      type="u16"  unit="bytes" default="65527"/>
    <param key="send_udp_payload_size"      type="usize" unit="bytes" default="1200"/>
    <param key="enable_dplpmtud"            type="bool"             default="true"  ffiReachable="false"/>
  </category>

  <category name="flow_control">
    <param key="initial_max_data"                   type="u64" unit="bytes" default="10485760"/>
    <param key="initial_max_stream_data_bidi_local" type="u64" unit="bytes" default="5242880"/>
    <param key="initial_max_stream_data_bidi_remote" type="u64" unit="bytes" default="2097152"/>
    <param key="initial_max_stream_data_uni"        type="u64" unit="bytes" default="1048576"/>
    <param key="initial_max_streams_bidi"           type="u64"              default="200"/>
    <param key="initial_max_streams_uni"            type="u64"              default="100"/>
    <param key="max_connection_window"              type="u64" unit="bytes" default="15728640"/>
    <param key="max_stream_window"                  type="u64" unit="bytes" default="6291456"/>
  </category>

  <category name="congestion_control">
    <param key="congestion_control_algorithm" type="enum" default="bbr"
           choices="cubic,bbr,bbr3,copa,dummy,lia,olia"/>
    <param key="initial_congestion_window"  type="u64" unit="packets" default="10"/>
    <param key="min_congestion_window"      type="u64" unit="packets" default="2"/>
    <param key="initial_rtt"                type="u64" unit="ms"      default="333" min="1"/>
    <param key="enable_pacing"              type="bool"              default="true"/>
    <param key="pacing_granularity"         type="u64" unit="ms"     default="1"/>
    <param key="pto_linear_factor"          type="u64"               default="0"/>
    <param key="max_pto"                    type="u64" unit="ms"     default="0"/>
    <param key="max_ack_delay"              type="u64" unit="ms"     default="25"/>
    <param key="ack_delay_exponent"         type="u64"               default="3"/>
  </category>

  <category name="bbr">
    <param key="bbr_probe_rtt_duration"     type="u64" unit="ms"     default="200"/>
    <param key="bbr_probe_rtt_based_on_bdp" type="bool"              default="false"/>
    <param key="bbr_probe_rtt_cwnd_gain"    type="f64"               default="0.75"/>
    <param key="bbr_rtprop_filter_len"      type="u64" unit="ms"     default="10000"/>
    <param key="bbr_probe_bw_cwnd_gain"     type="f64"               default="2.0"/>
  </category>

  <category name="copa">
    <param key="copa_slow_start_delta"      type="f64"               default="0.04"/>
    <param key="copa_steady_delta"          type="f64"               default="0.04"/>
    <param key="copa_use_standing_rtt"      type="bool"              default="true"/>
  </category>

  <category name="multipath">
    <param key="enable_multipath"           type="bool"              default="false"/>
    <param key="multipath_algorithm"        type="enum"              default="minrtt"
           choices="minrtt,redundant,roundrobin,ecf,erf,thle,thlev2"/>
    <param key="file_size_mp_scheduler"     type="usize" unit="bytes" default="0" ffiReachable="false"/>
    <param key="local_addresses"            type="list"              default=""/>
  </category>

  <category name="patfb">
    <param key="enable_path_arrival_time_feedback" type="bool"       default="false" ffiReachable="false"/>
  </category>

  <category name="tls">
    <param key="alpn"                       type="string"            default="h3"/>
    <param key="enable_early_data"          type="bool"              default="false"/>
    <param key="disable_encryption"         type="bool"              default="false"/>
    <param key="enable_stateless_reset"     type="bool"              default="true"/>
  </category>

  <category name="logging">
    <param key="log_level"                  type="enum"              default="info"
           choices="off,error,warn,info,debug,trace"/>
    <param key="log_file"                   type="string"            default=""/>
    <param key="keylog_file"                type="string"            default=""/>
    <param key="qlog_dir"                   type="string"            default=""/>
    <param key="dump_dir"                   type="string"            default=""/>
  </category>
</tquicConfig>
